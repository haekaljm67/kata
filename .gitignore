# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# SECRETS: never upload these.
# .env files hold keys and passwords (for example Supabase keys later).
.env*
# ...except a template with empty values, which is safe to share.
!.env.example
# Private keys and certificates.
*.key
*.p12
*.pfx
# Supabase's local working files (some contain project details).
supabase/.temp/
supabase/.branches/
# Claude Code's personal settings for this computer.
.claude/settings.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
